# ==============================================================================
# Hostinger Business Plan Environment Configuration
# ==============================================================================

# Server Port (Hostinger sets this automatically or defaults to 5000)
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# Hostinger MySQL Database (Recommended on Hostinger Business Plan)
# ------------------------------------------------------------------------------
# In Hostinger hPanel -> Databases -> MySQL Databases:
# Host is usually 'localhost' or '127.0.0.1' on Hostinger shared hosting
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=u123456789_printcatalyst
MYSQL_USER=u123456789_admin
MYSQL_PASSWORD=your_hostinger_mysql_password

# ------------------------------------------------------------------------------
# Local SSD Storage Mode (Zero-Config Fallback)
# ------------------------------------------------------------------------------
# If you leave MYSQL_DATABASE empty, Print Support automatically uses
# high-speed local NVMe/SSD persistence stored at: server/data/database.json
# with automatic atomic backups.

# ------------------------------------------------------------------------------
# External Cloud MongoDB (Optional - only if using external MongoDB)
# ------------------------------------------------------------------------------
# MONGODB_URI=
# MONGODB_DB_NAME=printcatalyst
